# Copy via scripts/up.cmd or scripts/setup-local.ps1. Never commit .env.
DEEPSEEK_API_KEY=replace-with-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
ENGINE_INTERNAL_TOKEN=replace-with-a-long-random-token
DB_PASSWORD=replace-with-a-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
# Optional. Existing installations may point this at a preserved runtime directory.
LESSONGEN_RUNTIME_ROOT=./runtime/lessongen
PAPER4_WEB_STATE_ROOT=./runtime/lessongen/engine-state
PAPER4_ARTIFACTS_ROOT=./runtime/lessongen/engine-artifacts
LESSON_STORAGE_ROOT=./runtime/lessongen/web-storage
